---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const sortedProjects = [...projects]
  .filter((p) => !p.data.hidden)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.title.localeCompare(b.data.title));
const featuredProjects = sortedProjects.filter((p) => p.data.featured);
const highlightedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 4);

const skills = [
  { title: 'Applied AI', items: ['Speech recognition and translation', 'Agent orchestration and tool use', 'Retrieval and memory', 'Evaluation and review workflows'] },
  { title: 'Software delivery', items: ['Python and TypeScript', 'Flutter and Dart', 'Astro and Node.js', 'SQLite, testing and automation'] },
  { title: 'Operating systems', items: ['Windows and Linux', 'Docker and GitHub Actions', 'AWS and Terraform', 'Monitoring and recovery'] },
];
const myExperience = [
  {
    title: 'Independent product and client work',
    period: 'Current work',
    company: 'AI engineering and software development',
    bullets: [
      'Design and operate an AI working environment with shared memory, tools and human review.',
      'Build Theophonia, a Greek lecture transcription, translation and quality review pipeline.',
      'Develop and maintain StreakUp, available on Google Play and the App Store.',
      'Deliver websites, applications and automation through <a href="https://www.ktisisarc.com/">Ktisis Arc</a>.',
    ],
  },
  {
    title: 'Systems and infrastructure',
    period: '2020 to present',
    company: 'Independent projects',
    bullets: [
      'Configure and maintain computers, networks and local services.',
      'Automate recurring checks and preserve recovery paths when work is interrupted.',
    ],
  },
];
---

<Layout>
  <section id="home" class="scroll-mt-32 text-center sm:mb-24">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-8">
      <div class="relative flex h-36 w-36 items-center justify-center">
        <div class="avatar-ring"></div>
        <div class="avatar-gradient"></div>
        <img
          src="/assets/FC2.jpg"
          alt="Alexander Kemos"
          class="relative z-10 h-28 w-28 rounded-full object-cover shadow-lg shadow-indigo-200/40"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <h1 class="text-balance text-4xl font-semibold leading-tight text-gray-900 sm:text-6xl dark:text-white">
        Hi, I'm <span class="text-gradient">Alexander Kemos</span>
      </h1>
      <p class="hero-role">AI engineer and founder of <a href="https://www.ktisisarc.com/">Ktisis Arc</a></p>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        I design and ship AI systems, mobile products, and business software through Ktisis Arc. My work includes a Greek speech and translation pipeline, a dual provider agent platform, and StreakUp on both app stores.
      </p>
      <div class="flex flex-col items-center justify-center gap-3 text-base font-medium sm:flex-row">
        <a class="btn-secondary" href="/projects">Explore projects</a>
        <a class="btn-secondary" href="https://github.com/AlexanderGRTCh" target="_blank" rel="noopener">GitHub</a>
        <a class="btn-secondary" href="#contact">Discuss a project or role</a>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="section-heading">
      <span class="section-kicker">About</span>
      <h2 class="section-title">Engineering ideas into working systems</h2>
      <p class="section-description">
        I am based in Vancouver and studied computer science at Langara College.
        Through Ktisis Arc, I work across AI pipelines, retrieval, agent orchestration, mobile apps, and web software.
        Building my own products gives me direct responsibility for architecture, release decisions, maintenance, and the business around the code.
      </p>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="section-heading">
      <span class="section-kicker">Projects</span>
      <h2 class="section-title">Selected work</h2>
      <p class="section-description">
        Applied AI with the architecture, implementation choices, evidence, and limits visible.
      </p>
    </div>

    {highlightedProjects.length === 0 ? (
      <p class="text-center text-gray-500">Projects will appear here.</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {highlightedProjects.map((project) => (
          <div class="card group overflow-hidden">
            <a href={`/projects/${project.slug}`} class="block">
              <div class="relative h-56 w-full overflow-hidden">
                <img
                  src={project.data.thumbnail}
                  alt={project.data.title}
                  loading="lazy"
                  class="h-full w-full object-contain bg-[#101d32]"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/70 via-transparent opacity-0 transition group-hover:opacity-100"></div>
              </div>
              <div class="p-6 pb-3">
                <p class="project-status">{project.data.status}</p>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{project.data.title}</h3>
                <p class="mt-3 text-gray-600 dark:text-gray-300">{project.data.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.data.tags.slice(0, 3).map((tag) => (
                    <span class="pill">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
            <div class="px-6 pb-6 flex flex-wrap items-center gap-3 text-sm font-semibold">
              <a href={`/projects/${project.slug}`} class="btn-tertiary">View project</a>
              {project.data.clientLinks?.map((link) => (
                <a href={link.url} class="btn-tertiary" target="_blank" rel="noopener">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="mt-8 flex justify-center">
      <a href="/projects" class="btn-secondary">View full project archive</a>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="section-heading">
      <span class="section-kicker">Skills</span>
      <h2 class="section-title">Engineering range</h2>
      <p class="section-description">
        From model workflows and retrieval to application state, infrastructure, testing, and release.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {skills.map((group) => (
        <div class="card h-full p-6" key={group.title}>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{group.title}</h3>
          <ul class="mt-4 space-y-2 text-gray-600 dark:text-gray-300">
            {group.items.map((item) => (
              <li key={item} class="flex items-center gap-2">
                <span class="h-2 w-2 shrink-0 rounded-full bg-indigo-500"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="experience" class="section">
    <div class="section-heading">
      <span class="section-kicker">Experience</span>
      <h2 class="section-title">Highlights from the journey</h2>
      <p class="section-description">
        Building, shipping and learning from real operating constraints.
      </p>
    </div>
    <div class="relative border-l border-gray-200 pl-8 dark:border-gray-700">
      {myExperience.map((item) => (
        <div class="timeline-item" key={item.title}>
          <div class="timeline-dot"></div>
          <div class="timeline-content card">
            <div class="p-6">
              <span class="text-sm font-semibold uppercase tracking-wide text-indigo-500">{item.period}</span>
              {item.title && <h3 class="mt-2 text-xl font-semibold text-gray-900 dark:text-white">{item.title}</h3>}
              {item.roles ? (
                <div class="mt-4 space-y-4">
                  {item.roles.map((role) => (
                    <div key={role.title}>
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h4 class="text-base font-semibold text-gray-800 dark:text-gray-200">{role.title}</h4>
                        <span class="text-xs font-medium text-gray-400">{role.period}</span>
                      </div>
                      <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{role.company}</p>
                      {role.note && (
                        <p class="text-xs italic text-gray-400 dark:text-gray-500 mt-0.5">{role.note}</p>
                      )}
                      <ul class="mt-2 list-disc pl-5 space-y-1 text-gray-600 dark:text-gray-300">
                        {role.bullets.map((point) => (
                          <li set:html={point}></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <>
                  <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{item.company}</p>
                  {item.bullets ? (
                    <ul class="mt-3 list-disc pl-5 space-y-1 text-gray-600 dark:text-gray-300">
                      {item.bullets.map((point) => (
                        <li set:html={point}></li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mt-3 text-gray-600 dark:text-gray-300">{item.description}</p>
                  )}
                </>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="education" class="section">
    <div class="section-heading">
      <span class="section-kicker">Education</span>
      <h2 class="section-title">Academic background</h2>
    </div>
    <div class="card p-6">
      <span class="text-sm font-semibold uppercase tracking-wide text-indigo-500">Graduated April 2025</span>
      <h3 class="mt-2 text-xl font-semibold text-gray-900 dark:text-white">Associate of Science, Computer Science</h3>
      <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Langara College, Vancouver, BC</p>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="section-heading">
      <span class="section-kicker">Contact</span>
      <h2 class="section-title">Let's collaborate</h2>
      <p class="section-description">
        Have a business process to improve or an AI engineering role to discuss? Tell me what you are trying to achieve.
      </p>
    </div>
    <div class="card p-8">
      <form action="https://usebasin.com/f/9cc815c9e668" method="POST" class="grid gap-4 md:grid-cols-2">
        <label class="form-label">
          Name
          <input type="text" name="name" required class="input mt-2" />
        </label>
        <label class="form-label">
          Email
          <input type="email" name="email" required class="input mt-2" />
        </label>
        <label class="form-label md:col-span-2">
          Message
          <textarea name="message" rows="4" required class="input mt-2"></textarea>
        </label>
        <div class="md:col-span-2">
          <div class="cf-turnstile" data-sitekey="0x4AAAAAACEaBeyP2pMmy3_x"></div>
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="btn-primary w-full md:w-auto">Send message</button>
        </div>
      </form>
      <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm font-medium">
        <a class="btn-tertiary" href="https://github.com/AlexanderGRTCh" target="_blank" rel="noopener">GitHub</a>
        <a class="btn-tertiary" href="https://www.linkedin.com/in/alexanderkemos" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
